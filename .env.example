# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Admin Telegram ID (optional - for health check alerts)
# To get your ID, message @userinfobot on Telegram
# ADMIN_TELEGRAM_ID=123456789

# Appointment Check Interval (optional - default: 2 minutes)
# How often to check for new appointments (minimum: 5, maximum: 600)
# Lower values = faster notifications but more API calls
CHECK_INTERVAL=120

# Analytics is optional; keep it disabled unless you configure Umami.
ANALYTICS_ENABLED=false
# UMAMI_ENDPOINT=http://localhost:3000
UMAMI_WEBSITE_ID=your-website-uuid-from-umami

# Official Munich booking UI monitor; times use Europe/Berlin.
MONITOR_SCHEDULE=weekday@06:55-08:45=120;weekday@08:45-13:40=240;weekday@13:40-14:45=120;weekday@14:45-18:00=240;weekday@18:00-23:00=600;weekday@23:00-06:55=900;weekend@00:00-24:00=750
# Entries are priority ordered. #latest selects the latest time on the earliest matching day.
APPOINTMENT_WINDOWS=2026-10-20..2026-10-30@00:00-23:59;2026-11-02..2026-11-20@07:00-08:40#earliest;2026-11-02..2026-11-20@16:00-23:59#latest;2026-11-21..2026-11-24@00:00-23:59
SLOT_EVENTS_FILE=monitor/slot_events.json
MONITOR_METRICS_FILE=monitor/metrics.jsonl
MONITOR_STATE_FILE=monitor/booking.state.json
MONITOR_LOG_FILE=monitor/monitor.log
# A slot is not notified again until this many minutes after its last alert.
ALERT_COOLDOWN_MINUTES=30
# Starts in monitor-only mode. Set true only after filling all BOOKING_* fields.
AUTO_BOOK_ENABLED=false
BOOKING_FIRST_NAME=
BOOKING_LAST_NAME=
BOOKING_EMAIL=
BOOKING_DATE_OF_BIRTH=
# Telegram destination for availability / booking alerts
TELEGRAM_CHAT_ID=
